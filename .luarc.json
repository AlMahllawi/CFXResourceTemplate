{
    "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "Lua 5.4",
        "nonstandardSymbol": [
            "/**/",
            "`",
            "+=",
            "-=",
            "*=",
            "/=",
            "<<=",
            ">>=",
            "&=",
            "|=",
            "^="
        ],
        "plugin": "${env:CFX_LUALS_ADDON}/plugin.lua"
    },
    "workspace": {
        "library": [
            "${env:CFX_LUALS_ADDON}/library",
            "definitions_vendor"
        ],
        "ignoreDir": [
            ".git",
            ".github",
            ".vscode",
            "/definitions",
            "node_modules",
            "web"
        ]
    }
}
